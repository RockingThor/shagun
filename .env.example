# Copy to .env.local. Demo mode is the default when YOUCAM_API_KEY is unset.

# India-region YouCam host (docs.makeupar.com). Override for the global console.
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Secret. Server-only. Never expose to the browser.
YOUCAM_API_KEY=

# Force demo even if a key is present. Unset + no key also enables demo.
DEMO_MODE=true

# Live-mode daily cap per client IP (look starts, not polls).
YOUCAM_DAILY_IP_CAP=8

# Polling interval used by the server when it checks a YouCam task (ms).
YOUCAM_POLL_HINT_MS=2000

# --- Paths marked [UNVERIFIED] in the research notes; override if the console differs ---
YOUCAM_FILE_PATH=/s2s/v2.0/file
YOUCAM_CLOTHES_PATH=/s2s/v2.0/task/cloth-v4
YOUCAM_EARRING_PATH=/s2s/v2.0/task/2d-vto/earring
YOUCAM_HAIR_PATH=/s2s/v2.1/task/hair-transfer
YOUCAM_MAKEUP_PATH=/s2s/v2.0/task/makeup-vto

# Makeup VTO lipstick shape label from lipshape.json (default: original).
YOUCAM_LIP_SHAPE=original

# Optional hair-transfer template IDs from GET /s2s/v2.1/task/template/hair-transfer
# If unset, live mode uploads the hairstyle catalog PNG/JPG as ref_file.
# YOUCAM_HAIR_TEMPLATE_GAJRA_WAVES=
# YOUCAM_HAIR_TEMPLATE_BRIDAL_BUN=
# YOUCAM_HAIR_TEMPLATE_SLEEK_PART=
# YOUCAM_HAIR_TEMPLATE_SIDE_SWEEP=
